    { "use": "text", "fg": "feedback.danger", "bg": "background", "where": "mensajes de error" },
    { "use": "text", "fg": "feedback.warning", "bg": "background", "where": "mensajes de aviso" },
    { "use": "text", "fg": "feedback.success", "bg": "background", "where": "mensajes de éxito" },
    { "use": "text", "fg": "feedback.info", "bg": "background", "where": "enlaces / info" },

    { "use": "text", "fg": "background", "bg": "feedback.info", "where": "button primary" },
